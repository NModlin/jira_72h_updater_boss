{
  "name": "jira-72h-updater-boss",
  "version": "1.0.0",
  "description": "Boss Edition with integrated visual dashboard - Track team's Jira tickets with AI-powered insights",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd dashboard && npm run dev\" \"electron .\"",
    "build:dashboard": "cd dashboard && npm run build",
    "build": "npm run build:dashboard && electron-builder",
    "build:win": "npm run build:dashboard && electron-builder --win",
    "build:mac": "npm run build:dashboard && electron-builder --mac",
    "build:all": "npm run build:dashboard && electron-builder -mw"
  },
  "keywords": [
    "jira",
    "electron",
    "notifications",
    "productivity",
    "manager",
    "boss"
  ],
  "author": "Nathan Modlin",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.nathanmodlin.jira72hupdaterboss",
    "productName": "Jira 72h Updater Boss Edition",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "dashboard/dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}